generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  name         String
  role         String        @default("admin")
  createdAt    DateTime      @default(now())
  orders       Order[]
  routes       Route[]
  vehicles     Vehicle[]
  savedOrigins SavedOrigin[]
  branchId     String?
  branch       Branch?       @relation("UserBranch", fields: [branchId], references: [id])
  createdBranches Branch[]    @relation("BranchCreator")
  products     Product[]
}

/// El catálogo, espejo de Ventra POR SUCURSAL (llega vía PEDIDO, ver sync-queue.mjs).
///
/// Tenía una nota que decía "SIN sucursal, a propósito: son los mismos para toda la
/// empresa". Es verdad para el peso y falso para lo demás: en Ventra el PRECIO y las
/// EXISTENCIAS varían por sucursal —su propia documentación lo dice—, así que un catálogo
/// único acaba ofreciendo en Camagüey un producto que sólo hay en La Habana, y al precio
/// de La Habana.
///
/// Se llena solo. No hay alta manual ni importación a mano: PEDIDO sondea Ventra cada
/// doce horas y aquí se copia lo que él ya tiene, que es el mismo dato con el que se pesa
/// y se cotiza. Dos catálogos escritos por separado discrepan sin que nadie lo vea.
model Product {
  id              String   @id @default(cuid())
  name            String
  weight          Float    @default(0)
  packaging       String?
  unitsPerPackage Float?
  category        String?
  /// El código de Ventra. Es por lo que se reconoce una fila entre pasadas.
  sku             String?
  /// La sucursal a la que pertenece ESTA fila (código: HAB, CMG…). Null = de antes.
  sucursalCodigo  String?
  /// Precio y existencias EN ESA sucursal, tal como los da Ventra.
  price           Float?
  stock           Float?
  unit            String?
  /// Cuándo lo trajo Ventra. Dice si lo que se está mirando es de hace diez minutos o
  /// de hace tres días porque la VPN lleva caída desde el lunes.
  traidoAt        DateTime?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt

  @@unique([sucursalCodigo, sku])
  @@index([sucursalCodigo])
  @@index([name])
}

// Espejo (mirror) de los clientes GEOLOCALIZADOS de PEDIDO. MISMO patrón que Order:
// source + externalId (idempotencia por [source, externalId], re-sync no duplica) y meta
// con el payload COMPLETO tal como llega de PEDIDO. Se sincroniza SOLO (sync-queue.mjs),
// no manual: un cliente nuevo/actualizado con geo en PEDIDO entra en el próximo ciclo.
// Solo con geo (lat/lng): sin coordenadas no se cotiza. `source=null` => cliente manual.
model Customer {
  id             String   @id @default(cuid())
  source         String? // "pedido" si vino de la app PEDIDO, null si es manual
  externalId     String? // id del cliente en PEDIDO
  name           String
  phone          String?
  address        String?
  municipio      String?
  zona           String?
  /// El código del cliente en PEDIDO (SC06TCP1257). Es como lo nombra la gente.
  codigo         String?
  /// De quién es: el vendedor que lo atiende. Estaba dentro de `meta` —el payload
  /// entero— así que filtrar por él obligaba a leer y descartar los siete mil clientes.
  vendedor       String?
  lat            Float
  lng            Float
  sucursalCodigo String?
  meta           Json? // payload COMPLETO del cliente tal como llega de PEDIDO
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([source, externalId])
  @@index([vendedor])
  @@index([codigo])
}

model Branch {
  id         String   @id @default(cuid())
  name       String
  address    String?
  lat        Float
  lng        Float
  areaKm2    Float    @default(1)
  // Id de la sucursal equivalente en la app PEDIDO. Permite que PEDIDO cotice
  // un domicilio mandando solo su id de sucursal y delivery resuelve las coords.
  externalId String?  @unique
  // El usuario fijó el PUNTO DE PARTIDA real (ubicación del almacén). Mientras sea
  // false, el cálculo de domicilios NO corre para esta sucursal (espera).
  originConfigured Boolean @default(false)
  creatorId  String
  creator    User     @relation("BranchCreator", fields: [creatorId], references: [id])
  members    User[]   @relation("UserBranch")
  origins    SavedOrigin[]
  orders     Order[]
  vehicles   Vehicle[] @relation("BranchVehicles")
  routes     Route[]   @relation("BranchRoutes")
  createdAt  DateTime @default(now())
}

model SavedOrigin {
  id        String   @id @default(cuid())
  name      String
  address   String
  lat       Float
  lng       Float
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
}

model Vehicle {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("truck")
  plate     String?
  capacity  Float    @default(1000)
  // Costo de rodar este camión, en USD por km (lo da el camionero). Con la capacidad
  // define el CKK de la fórmula oficial del domicilio: costoKmUsd·tc/(0.5·capacidad).
  costoKmUsd Float?
  // Marca el vehículo de REFERENCIA de su sucursal para CALCULAR el domicilio.
  // Solo uno por sucursal debería tenerla en true.
  usarParaDomicilio Boolean @default(false)
  status    String   @default("available")
  notes     String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  // Sucursal dueña del vehículo (para el scoping multi-sucursal). null = de todas.
  branchId  String?
  branch    Branch?  @relation("BranchVehicles", fields: [branchId], references: [id])
  routes    Route[]
  orders    Order[]
  orderAssignments OrderVehicle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id              String    @id @default(cuid())
  operationNumber String?
  customerName    String
  address         String
  endAddress      String?
  endLat          Float?
  endLng          Float?
  lat             Float?
  lng             Float?
  weight          Float     @default(1)
  status          String    @default("pending")
  tripLeg         String    @default("outbound")
  notes           String?
  routeId         String?
  route           Route?    @relation(fields: [routeId], references: [id])
  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  price           Float?
  segmentKm       Float?
  // Precio del envío a domicilio INDIVIDUAL (viaje dedicado sucursal → cliente).
  // Fuente de verdad para lo que se le cobra al cliente y lo que registra la
  // contabilidad en PEDIDO. Independiente de `price` (precio de reparto de ruta);
  // el flujo de rutas no lo sobrescribe.
  deliveryPrice      Float?
  deliveryDistanceKm Float?
  // Sucursal de origen desde la que se calculó el domicilio.
  branchId        String?
  branch          Branch?   @relation(fields: [branchId], references: [id])
  // Procedencia: "pedido" si entró desde la app PEDIDO, null si es manual.
  source          String?
  // La FECHA DEL PEDIDO en PEDIDO, que no es `createdAt`.
  //
  // `createdAt` es cuándo lo copió el espejo, y el espejo copia muchos días de golpe:
  // todos los pedidos quedaban con la fecha de hoy. El armador de rutas filtra por día,
  // así que cualquier día que no fuera hoy devolvía CERO pedidos aunque los hubiera.
  orderDate       DateTime?
  // Cuándo se tocó por última vez EN PEDIDO. Es la marca de agua del espejo: la próxima
  // sincronización pide `since=max(pedidoUpdatedAt)` y sólo se trae lo que se movió.
  //
  // Se guarda aquí y no en una tabla de estado a propósito: un contador aparte se
  // desincroniza del contenido —se adelanta si una tanda falla a medias— y entonces el
  // espejo se salta pedidos para siempre sin dar ningún error. Derivándola de los datos,
  // lo que no se guardó no cuenta como sincronizado.
  pedidoUpdatedAt DateTime?
  // El ESTADO en PEDIDO, tal cual: 'completada', 'en_proceso' o nada.
  //
  // Delivery necesita verlos todos —una ruta se arma también con pedidos ya completados—
  // pero mezclados sin distinguir no se puede trabajar. Se guarda para poder FILTRAR, no
  // para decidir nada: quien manda sobre el estado es PEDIDO.
  estado          String?
  // Archivado en PEDIDO (borrado blando: se esconde de su lista, no se borra). Son la
  // inmensa mayoría del histórico.
  archivado       Boolean   @default(false)
  // Cuándo se comprometió la entrega. `expirado` NO se guarda: es que esta fecha ya pasó
  // y el pedido no se completó, y un booleano guardado se queda viejo al día siguiente.
  fechaComprometida DateTime?
  // Si el pedido lleva domicilio, y el costo que le puso la APK EN PEDIDO. Este último no
  // es `deliveryPrice`: aquél es el reparto de carga que calcula delivery para sus rutas.
  // Son dos números distintos y confundirlos es cobrar uno por el otro.
  requiereDomicilio Boolean?
  pedidoCosto     Float?
  // Municipio del cliente y vendedor del pedido, COPIADOS de `meta`.
  //
  // Estaban sólo dentro del JSON, así que para filtrar por ellos había que leerse el
  // pedido entero de cada fila y descartarlo. Con 50.000 pedidos eso no es un filtro:
  // es traerse la base a memoria en cada consulta.
  municipio       String?
  /// Los NOMBRES de los productos del pedido, en un solo texto.
  ///
  /// Es una copia de lo que ya está en `items`, y existe por una razón: dentro de un JSON
  /// no se puede buscar «malta» sin leerse los cincuenta mil pedidos. Es la pregunta del
  /// despacho —«¿qué pedidos llevan malta?»— y hasta ahora había que abrirlos uno a uno.
  productosTexto  String?
  /// Cómo quedó este pedido frente a la FACTURA de Ventra:
  ///   `igual`       — lo facturado coincide con lo pedido: se puede repartir tal cual.
  ///   `cambiado`    — se facturó otra cosa (más, menos, distinto).
  ///   `sin_factura` — todavía no se ha facturado.
  /// Vacío = no se ha cotejado (no hay facturación traída de ese día).
  facturaEstado   String?
  /// El número de factura con el que cuadró, para poder ir a buscarla.
  facturaNumero   String?
  facturaAt       DateTime?
  /// Lo que PESA lo FACTURADO, que no siempre es lo que pesa lo pedido.
  ///
  /// Se calcula con los mismos pesos de Ventra, sobre las líneas de la factura. Es lo que
  /// de verdad va a subir al camión, así que es lo que manda para la carga y para lo que
  /// cuesta el domicilio. Vacío cuando no hay factura o cuando ningún producto facturado
  /// tenía peso en Ventra — un cero se sumaría y diría que ese pedido no pesa nada.
  pesoFacturado   Float?
  /// Lo último que se le dijo a PEDIDO sobre esta factura: `estado|numero`.
  ///
  /// Sirve para no repetirse. Escribir en PEDIDO mueve su `updatedAt`, que es la marca de
  /// agua con la que sincronizan las tablets de los vendedores: reenviar cada minuto el
  /// mismo estado les haría bajarse el día entero por datos móviles para enterarse de que
  /// no ha pasado nada.
  facturaAvisado  String?
  vendedor        String?
  sucursalCodigo  String?
  // Id/folio del pedido en PEDIDO. Usado para idempotencia (re-cotizar no duplica).
  externalId      String?
  // Itemized breakdown of what to deliver to this client: [{ description, quantity }]
  items           Json      @default("[]")
  // Teléfono del cliente y payload COMPLETO tal como llega de PEDIDO (cliente + pedido),
  // para no perder ningún dato (municipio, tipo, encargado, folio, estado, etc.).
  customerPhone   String?
  meta            Json?
  vehicleAssignments OrderVehicle[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  stopOrder       Int?
  deliveredAt     DateTime?

  @@index([source, externalId])
  @@index([orderDate])
  // Los índices son de los filtros que la pantalla ofrece de verdad. Uno por columna y no
  // uno compuesto: se combinan de todas las formas y Postgres los cruza por su cuenta.
  @@index([pedidoUpdatedAt])
  @@index([estado])
  @@index([archivado])
  @@index([municipio])
  @@index([vendedor])
  @@index([requiereDomicilio])
}

model OrderVehicle {
  id        String   @id @default(cuid())
  orderId   String
  vehicleId String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([orderId, vehicleId])
}

model Route {
  id              String   @id @default(cuid())
  name            String?
  routeCode       String?
  status          String   @default("planned")
  originAddress   String?
  originLat       Float?
  originLng       Float?
  totalDistance   Float    @default(0)
  totalWeight     Float    @default(0)
  totalPrice      Float    @default(0)
  deliveryDate    DateTime?
  orders          Order[]
  vehicleId       String?
  vehicle         Vehicle? @relation(fields: [vehicleId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  // Sucursal de la ruta (para el scoping multi-sucursal).
  branchId        String?
  branch          Branch?  @relation("BranchRoutes", fields: [branchId], references: [id])
  /// Cuándo salió y cuándo volvió. Con las dos se sabe CUÁNTO SE DEMORÓ.
  ///
  /// No se deduce de `createdAt` ni de `updatedAt`: la ruta se arma la noche anterior y
  /// se toca al cambiarle cualquier cosa. La salida se marca al despacharla y el regreso
  /// al cerrarla, sin que nadie tenga que apuntar una hora.
  startedAt       DateTime?
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  optimized       Boolean  @default(false)
}

/// Una línea de FACTURA de Ventra: lo que de verdad se vendió.
///
/// El pedido y la factura no siempre coinciden —el cliente cambia lo que pidió antes de
/// que se le facture— y la ruta hay que armarla con lo facturado, no con lo pedido: es lo
/// que va en el camión y es lo que se cobra.
///
/// Es un espejo: se trae de Ventra y no se escribe nunca hacia allá.
model VentaFacturada {
  id            String   @id @default(cuid())
  /// El id de la línea en Ventra. Por él se reconoce entre pasadas.
  ventraId      String   @unique
  /// El código de la sucursal (HAB, CMG…).
  sucursalCodigo String
  fecha         DateTime
  /// El número de operación: es LA FACTURA. Varias líneas comparten número.
  operNumber    String
  clienteCodigo String?
  clienteNombre String
  productoCodigo String?
  productoNombre String
  cantidad      Float
  precioUsd     Float?
  traidoAt      DateTime @default(now())

  @@index([sucursalCodigo, fecha])
  @@index([clienteNombre])
  @@index([operNumber])
}

model Settings {
  id        String @id @default(cuid())
  /// Por dónde va el barrido del histórico, en DÍAS HACIA ATRÁS.
  ///
  /// El espejo repasa el año entero un trozo por ciclo y vuelve a empezar al llegar al
  /// final. Hace falta GUARDAR la posición porque de los datos no se puede deducir: el
  /// espejo tiene pedidos viejos sueltos —de cuando se traía todo—, así que "el más
  /// antiguo que tengo" no significa "tengo todo hasta ahí". Deducirlo así arrancaba el
  /// barrido a 357 días y se saltaba entero el año de en medio, que era justo lo que
  /// faltaba por recuperar.
  ///
  /// Que se pueda adelantar no rompe nada, y por eso aquí sí es aceptable un contador:
  /// lo que se mueva sigue llegando por `since` en cada ciclo, y el barrido da la vuelta
  /// al año una y otra vez, así que un día saltado se recoge en la pasada siguiente.
  syncBarridoDia Int @default(0)
  /// Cuándo se trajo por última vez el catálogo de Ventra.
  ///
  /// El catálogo cambia poco —precios un par de veces al día como mucho— y Ventra se
  /// llega por VPN: preguntarle en cada ciclo del espejo (cada minuto) sería cargar un
  /// enlace delicado por gusto. Con la marca aquí, el espejo sabe si ya toca.
  catalogoTraidoAt DateTime?
  baseFee   Float  @default(5.0)
  costPerKm Float  @default(1.5)
  costPerKg Float  @default(0.5)
  // Parámetros del envío a domicilio INDIVIDUAL (separados de los de ruta).
  // Default 0 → la fórmula se reduce a base + dist + peso hasta que se configuren.
  domBaseFee    Float @default(0)
  domCostPerKm  Float @default(0)
  domCostPerKg  Float @default(0)
  domIncludedKm Float @default(0)
  domMinFee     Float @default(0)
  domRoundTo    Float @default(0)
  // Tipo de cambio para el domicilio (fórmula oficial): CUP por 1 USD = "toque + 20".
  // El costo se calcula en CUP y se guarda en USD dividiendo por este valor.
  domTipoCambio Float @default(700)
  // Factor de la capacidad usado en el CKK (0.5 = 50%, el camion va medio lleno en
  // promedio). Editable para no dejar numeros escondidos.
  domFactorCapacidad Float @default(0.5)
  // Tipos de vehículo con su costo/km por defecto (el "padre"). Al crear un vehículo de
  // ese tipo se hereda el costo/km, y se puede cambiar por vehículo.
  // [{ nombre: "Camión", costoKmUsd: 1.65 }, { nombre: "Camioneta", costoKmUsd: 0.9 }]
  tiposVehiculo Json?
  // El usuario guardó la FÓRMULA del domicilio. Mientras sea false, el cálculo
  // NO corre (espera). Se pone true al guardar la fórmula en Settings.
  domConfigured Boolean @default(false)
  currency  String @default("USD")
  cupRate   Float  @default(320.0)
  cupRateUpdatedAt DateTime @default(now())
  // Display currencies relative to USD (base = 1). Array of { code, rate } where
  // rate = units of this currency per 1 USD. e.g. [{"code":"CUP","rate":320}]
  currencies Json @default("[]")
}

// La tabla SyncJob se va con la pantalla de sincronización.
//
// Era la cola que procesaba los pedidos de uno en uno para que esa pantalla pudiera
// enseñar el progreso en vivo. Sin pantalla que mirar, la cola sólo servía para tardar
// más: el espejo ahora se trae el lote entero de una vez.
