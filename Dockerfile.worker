# Worker de la COLA de delivery (sync-queue.mjs).
#
# La imagen standalone de Next (Dockerfile principal) NO incluye node_modules
# completos ni el CLI de Prisma para correr un proceso aparte, por eso el worker
# se construye con su propia imagen ligera.
FROM node:22-alpine
WORKDIR /app

# OpenSSL: requerido por el query engine de Prisma en Alpine.
RUN apk add --no-cache openssl

ENV NODE_ENV=production

# Dependencias primero (mejor cache de capas).
# Playwright es una herramienta de PRUEBAS: aquí sólo se instala el paquete, nunca los
# navegadores. Su script de instalación se baja ~150 MB de Chromium por su cuenta, y en la
# imagen de producción eso es tiempo de build y peso de imagen para algo que nunca se va a
# ejecutar: los navegadores viven en la imagen de Playwright, que es donde corren las
# pruebas (ver PRUEBAS.md).
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY package.json package-lock.json* ./
RUN npm ci

# Esquema + migraciones de Prisma y generacion del cliente.
COPY prisma ./prisma
RUN npx prisma generate

# El worker propiamente dicho.
COPY sync-queue.mjs ./sync-queue.mjs

CMD ["node", "sync-queue.mjs"]
